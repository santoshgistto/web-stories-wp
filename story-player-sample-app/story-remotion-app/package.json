{
  "name": "story-remotion-app",
  "version": "0.0.0",
  "private": true,
  "description": "Render Web Stories to video with Remotion, driving the story-player's WAAPI animations from Remotion's frame clock.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts StoryVideo out/video.mp4",
    "still": "remotion still src/index.ts StoryVideo out/frame.png",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/styled-components": "^5.1.34",
    "babel-loader": "^9.1.3",
    "babel-plugin-styled-components": "^2.1.4",
    "typescript": "^5.4.0"
  }
}
