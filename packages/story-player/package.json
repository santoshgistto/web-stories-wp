{
  "name": "@googleforcreators/story-player",
  "description": "Standalone React player for rendering Web Stories outside the editor.",
  "private": false,
  "version": "0.1.0",
  "author": {
    "name": "Google",
    "url": "https://creators.google/"
  },
  "license": "Apache-2.0",
  "keywords": [
    "web stories",
    "player"
  ],
  "homepage": "https://github.com/GoogleForCreators/web-stories-wp/blob/main/packages/story-player/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleForCreators/web-stories-wp.git",
    "directory": "packages/story-player"
  },
  "bugs": {
    "url": "https://github.com/googleforcreators/web-stories-wp/issues"
  },
  "engines": {
    "node": ">= 20 || >= 22 || >= 24",
    "npm": ">= 7.3"
  },
  "customExports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "main": "dist/index.js",
  "module": "dist-module/index.js",
  "types": "dist-types/index.d.ts",
  "source": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@googleforcreators/animation": "*",
    "@googleforcreators/element-library": "*",
    "@googleforcreators/elements": "*",
    "@googleforcreators/masks": "*",
    "@googleforcreators/media": "*",
    "@googleforcreators/patterns": "*",
    "@googleforcreators/react": "*",
    "@googleforcreators/transform": "*",
    "@googleforcreators/units": "*",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@types/react-native": "^0.73.0",
    "react": "^17.0.2",
    "react-native-web": "^0.18.12"
  }
}
